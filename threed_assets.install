<?php

/**
 * @file
 * Install/uninstall hooks for the 3D Assets module.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 *
 * Stands up the L1 Media data model (binary-leaf bundles + fields) on a
 * fresh install. The same logic is also exposed as the drush command
 * threed-assets:install-model for already-installed sites.
 */
function threed_assets_install(): void {
  $created = _threed_assets_ensure_media_model();
  if ($created) {
    \Drupal::logger('threed_assets')->notice('Created 3D Media bundles: @b', ['@b' => implode(', ', $created)]);
  }
}
